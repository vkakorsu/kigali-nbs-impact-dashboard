{
  "name": "kigali-nbs-impact-dashboard",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "MVP public-facing dashboard communicating the impact of SUNCASA nature-based solutions in the lower Nyabarongo watershed, Kigali.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/ingest.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "ingest": "node scripts/ingest.mjs",
    "export": "node scripts/export.mjs",
    "fmes:import": "node scripts/fmes-adapter.mjs",
    "test": "node --test scripts/ingest.test.mjs",
    "typecheck": "tsc --noEmit",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.0"
