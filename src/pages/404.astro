---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import { t } from "../lib/i18n";
---

<Base title="Page not found">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <svg
      width="120"
      height="120"
      viewBox="0 0 120 120"
      aria-hidden="true"
      focusable="false"
      class="mx-auto mb-6 opacity-90"
    >
      <path d="M60 8 L108 60 L60 112 L12 60 Z" fill="none" stroke="#d99a2b" stroke-width="5"></path>
      <path d="M60 34 L86 60 L60 86 L34 60 Z" fill="none" stroke="#9b3d22" stroke-width="4"></path>
      <path d="M60 50 L70 60 L60 70 L50 60 Z" fill="#175943"></path>
    </svg>
    <p class="headline tnum text-7xl text-highland/25 mb-4">404</p>
    <h1 class="headline text-3xl mb-3">
      <T en={t("notFoundTitle").en} rw={t("notFoundTitle").rw} />
    </h1>
    <p class="text-ink/70 mb-8 measure mx-auto">
      <T en={t("notFoundBody").en} rw={t("notFoundBody").rw} />
    </p>
    <a
      href="/"
      class="no-underline bg-highland text-paper font-semibold px-6 py-3 rounded-lg hover:bg-highland-deep transition-colors"
    >
      <T en={t("backHome").en} rw={t("backHome").rw} />
    </a>
  </section>
</Base>
