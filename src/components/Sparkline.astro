---
/**
 * Zero-JS trend line. Rendered at build time as a tiny inline SVG so
 * every indicator card carries its own visual without any runtime cost.
 */
interface Props {
  points: number[];
  color?: string;
  width?: number;
  height?: number;
  class?: string;
}

const {
  points,
  color = "var(--color-highland)",
  width = 120,
  height = 36,
  class: className = "",
} = Astro.props;

const pad = 3;
let linePath = "";
let areaPath = "";
let endX = 0;
let endY = 0;

if (points.length >= 2) {
  const min = Math.min(...points);
  const max = Math.max(...points);
  const span = max - min || 1;
  const step = (width - pad * 2) / (points.length - 1);
  const coords = points.map((v, i) => [
    pad + i * step,
    height - pad - ((v - min) / span) * (height - pad * 2),
  ]);
  linePath = coords
    .map(([x, y], i) => `${i === 0 ? "M" : "L"}${x.toFixed(1)} ${y.toFixed(1)}`)
    .join(" ");
  const last = coords[coords.length - 1];
  areaPath = `${linePath} L${last[0].toFixed(1)} ${height - pad} L${pad} ${height - pad} Z`;
  endX = last[0];
  endY = last[1];
}
---

{
  points.length >= 2 && (
    <svg
      width={width}
      height={height}
      viewBox={`0 0 ${width} ${height}`}
      aria-hidden="true"
      focusable="false"
      class={className}
      style={`color:${color};`}
    >
      <path d={areaPath} fill="currentColor" opacity="0.1" />
      <path
        d={linePath}
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle cx={endX} cy={endY} r="2.6" fill="currentColor" />
    </svg>
  )
}
