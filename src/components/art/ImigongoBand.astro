---
/**
 * A thin decorative strip of imigongo geometry, used as section
 * dividers, footer trim, and the hero base band. Pure inline SVG,
 * aria-hidden, a few hundred bytes.
 */
interface Props {
  variant?: "zigzag" | "diamond";
  color?: string;
  bg?: string;
  height?: number;
  class?: string;
}

const {
  variant = "zigzag",
  color = "var(--color-gold)",
  bg = "transparent",
  height = 14,
  class: className = "",
} = Astro.props;

const uid = `imi-${variant}-${Math.random().toString(36).slice(2, 8)}`;
const stroke = Math.max(2.5, height / 5);
const pad = stroke;
---

<div
  class={className}
  style={`background:${bg}; line-height:0;`}
  aria-hidden="true"
>
  <svg width="100%" height={height} role="presentation" focusable="false">
    <defs>
      {
        variant === "zigzag" ? (
          <pattern
            id={uid}
            patternUnits="userSpaceOnUse"
            width={height * 2.6}
            height={height}
          >
            <path
              d={`M0 ${height - pad} L${height * 1.3} ${pad} L${height * 2.6} ${height - pad}`}
              fill="none"
              style={`stroke:${color};`}
              stroke-width={stroke}
              stroke-linecap="square"
            />
          </pattern>
        ) : (
          <pattern
            id={uid}
            patternUnits="userSpaceOnUse"
            width={height * 1.8}
            height={height}
          >
            <path
              d={`M${height * 0.9} ${pad} L${height * 1.55} ${height / 2} L${height * 0.9} ${height - pad} L${height * 0.25} ${height / 2} Z`}
              fill="none"
              style={`stroke:${color};`}
              stroke-width={stroke * 0.8}
              stroke-linejoin="miter"
            />
          </pattern>
        )
      }
    </defs>
    <rect width="100%" height={height} fill={`url(#${uid})`}></rect>
  </svg>
</div>
