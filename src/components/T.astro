---
/**
 * Bilingual text helper. Renders both languages into the static HTML.
 * CSS driven by html[data-lang] shows exactly one, so language switching
 * is instant and works without JavaScript beyond the toggle itself.
 */
interface Props {
  en: string;
  rw: string;
}
const { en, rw } = Astro.props;
---

<span class="lang-en">{en}</span><span class="lang-rw" lang="rw">{rw}</span>
