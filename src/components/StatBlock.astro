---
/**
 * A single figure in the dark "programme at a glance" band. The number
 * is set in Newsreader with tabular figures and counts up on reveal
 * (static text without JavaScript or under reduced motion).
 */
import T from "./T.astro";
import type { Bilingual } from "../lib/i18n";

interface Props {
  value: number;
  label: Bilingual;
  unit?: Bilingual;
}

const { value, label, unit } = Astro.props;
const formatted = value.toLocaleString("en-US");
---

<div class="flex flex-col gap-1.5">
  <p class="headline tnum text-4xl md:text-5xl text-gold leading-none">
    <span data-countup={value}>{formatted}</span>
    {
      unit && (
        <span class="text-lg md:text-xl text-paper/70 font-sans font-medium ml-1">
          <T en={unit.en} rw={unit.rw} />
        </span>
      )
    }
  </p>
  <p class="text-sm text-paper/75 leading-snug">
    <T en={label.en} rw={label.rw} />
  </p>
</div>
